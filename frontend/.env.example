# Copy to .env and fill in. Only variables prefixed with VITE_ are exposed to
# the browser bundle, so never put a secret in this file.

# Base URL of the Express backend (backend/.env → PORT).
VITE_API_URL=http://localhost:8000

# WalletConnect Cloud project id — https://cloud.walletconnect.com
# Injected wallets (MetaMask, Rabby, …) work without it; WalletConnect-based
# mobile wallets will not connect until it is set.
VITE_WALLETCONNECT_PROJECT_ID=
