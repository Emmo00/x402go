NODE_ENV=development


# If this is the Mongo atlas connection string, mongodb+srv://<mongo-db-username>:<mongo-db-password>@instancename.oudcl.mongodb.net 
# then the connection string need to be set as follows
SESSION_SECRET=your_session_secret

MONGO_CONNECTION_URL=mongodb+srv://<mongo-db-username>:<mongo-db-password>@instancename.oudcl.mongodb.net/myFirstDatabase?retryWrites=true&w=majority
PORT=8000

OPERATOR_KEY=your_operator_key

# Pepper for API-key hashing (HMAC-SHA-256). It never leaves the server and must
# not be the same value as SESSION_SECRET. If it is unset the API-key code falls
# back to SESSION_SECRET; setting it means rotating one secret does not silently
# invalidate the other. Generate with: openssl rand -hex 32
API_KEY_PEPPER=your_api_key_pepper
