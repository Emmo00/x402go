{
  "compilerOptions": {
    "sourceMap": true,
    "target": "ES2020",
    "rootDir": ".",
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@facilitator/*": ["./facilitator/src/*"],
      "@backend/*": ["./src/*"]
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "alwaysStrict": true,
    "noImplicitAny": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node", "bun"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "facilitator/**/*.test.ts"
  ]
}
