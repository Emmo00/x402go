{
  "compilerOptions": {
    "sourceMap": true,
    "target": "ES2020",
    "rootDir": ".",
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@facilitator/*": ["./facilitator/src/*"],
      "@backend/*": ["./src/*"]
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "alwaysStrict": true,
    "noImplicitAny": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "typeRoots": [
      "node_modules/@types",
      "node_modules_ef/@types",
      "./src/@types/*.d.ts",
      "facilitator/src/**/*.ts"
    ],
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules_ef", "src/**/*.test.ts"]
}
