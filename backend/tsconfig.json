{
  "compilerOptions": {
    "sourceMap": true,
    "target": "es2017",
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@/*": ["./*"]
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "alwaysStrict": true,
    "noImplicitAny": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "typeRoots": ["node_modules/@types", "node_modules_ef/@types", "./src/@types"],
    "types": ["node", "bun"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules_ef", "src/**/*.test.ts"]
}
